# Hosted Supabase project. Keep real values in .env.local only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.your-project-ref:password@pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.your-project-ref:password@pooler.supabase.com:5432/postgres
DB_PASSWORD=
SUPABASE_PROJECT_REF=

# Local application.
APP_URL=http://localhost:3000
INTERNAL_WORKER_SECRET=replace-with-a-long-local-secret
ONBOARDING_INBOX_PROVIDER=local_mailpit
PORT=8080
WORKER_MAX_JOBS=50

# Standalone local Mailpit. No real email leaves the machine.
LOCAL_MAIL_API_URL=http://127.0.0.1:8025
LOCAL_MAIL_SMTP_HOST=127.0.0.1
LOCAL_MAIL_SMTP_PORT=1025
LOCAL_INBOX_ADDRESS=cargo@skyvalence.local
LOCAL_REPLY_FROM=Cargo Manager <cargo@skyvalence.local>

# Google Workspace OAuth. Generate the encryption key with:
# openssl rand -base64 32
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
INBOX_TOKEN_ENCRYPTION_KEY=
GMAIL_INITIAL_QUERY=newer_than:7d subject:"[Cargo Demo]"

# GCP Cloud Run deployment.
GCP_PROJECT_ID=sky-valance-cargo-manager
GCP_REGION=europe-west2

# Hosted open-weight extraction. Groq's strict JSON Schema mode is the local
# acceptance default. Keep customer data synthetic on free service tiers.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Optional Google-hosted Gemma adapter.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=
AI_MODEL=gemma-4-26b-a4b-it
