# Hosted Supabase project. Keep real values in .env.local only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.your-project-ref:password@pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.your-project-ref:password@pooler.supabase.com:5432/postgres
SUPABASE_PROJECT_REF=

# Local application.
APP_URL=http://localhost:3000
INTERNAL_WORKER_SECRET=replace-with-a-long-local-secret

# Standalone local Mailpit. No real email leaves the machine.
LOCAL_MAIL_API_URL=http://127.0.0.1:8025
LOCAL_MAIL_SMTP_HOST=127.0.0.1
LOCAL_MAIL_SMTP_PORT=1025
LOCAL_INBOX_ADDRESS=cargo@skyvalence.local
LOCAL_REPLY_FROM=Cargo Manager <cargo@skyvalence.local>

# Google-hosted open-weight Gemma model. Use synthetic data on the free tier.
AI_PROVIDER=google
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=
AI_MODEL=gemma-4-26b-a4b-it
